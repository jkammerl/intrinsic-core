"""
GLVND GL/EGL and host glib system library stubs from the sysroot.
- GLVND stubs are needed to route OpenGL calls to host drivers.
- Glib/GObject/GIO/GModule stubs are needed to link against host
  glib libraries when a target needs access to Qt6.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

# The repository contains either the amd64 or the arm64 sysroot, depending on
# the host architecture (see //bazel:non_module_deps.bzl).
_TRIPLE = "aarch64-linux-gnu" if glob(
    ["usr/lib/aarch64-linux-gnu/libGL.so"],
    allow_empty = True,
) else "x86_64-linux-gnu"

filegroup(
    name = "files",
    srcs = glob([
        # OpenGL and EGL deps
        "usr/lib/" + _TRIPLE + "/libGL.so*",
        "usr/lib/" + _TRIPLE + "/libGLX.so*",
        "usr/lib/" + _TRIPLE + "/libEGL.so*",
        "usr/lib/" + _TRIPLE + "/libGLdispatch.so*",
        "usr/lib/" + _TRIPLE + "/libOpenGL.so.*",
        "usr/lib/" + _TRIPLE + "/libX11.so*",
        "usr/lib/" + _TRIPLE + "/libxcb.so*",
        "usr/lib/" + _TRIPLE + "/libXau.so*",
        "usr/lib/" + _TRIPLE + "/libXdmcp.so*",
        "usr/lib/" + _TRIPLE + "/libXext.so*",
        "usr/lib/" + _TRIPLE + "/libbsd.so*",
        "usr/lib/" + _TRIPLE + "/libmd.so*",
    ]),
)

cc_library(
    name = "sysroot_glvnd_stubs",
    srcs = [":files"],
)

# We need to compile a dummy empty.cc file into all system glib stubs.
# Bazel's cc_shared_library rule has a strict analysis-phase check that fails
# if a target in its transitive deps contains only precompiled dynamic libraries
# (.so files) with no compiled objects. The dummy empty.cc forces Bazel to compile
# an object file and package it, satisfying the cc_shared_library check.
genrule(
    name = "empty_cc",
    outs = ["empty.cc"],
    cmd = "touch $@",
)

cc_library(
    name = "system_glib",
    srcs = glob([
        "usr/lib/" + _TRIPLE + "/libglib-2.0.so*",
        "lib/" + _TRIPLE + "/libpcre.so.3*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include",
    ],
)

cc_library(
    name = "system_gobject",
    srcs = glob([
        "usr/lib/" + _TRIPLE + "/libgobject-2.0.so*",
        "usr/lib/" + _TRIPLE + "/libffi.so.7*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include",
    ],
    deps = [":system_glib"],
)

cc_library(
    name = "system_gio",
    srcs = glob([
        "usr/lib/" + _TRIPLE + "/libgio-2.0.so*",
        "usr/lib/" + _TRIPLE + "/libmount.so.1*",
        "usr/lib/" + _TRIPLE + "/libblkid.so.1*",
        "lib/" + _TRIPLE + "/libselinux.so.1*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include/**/*.h",
        "usr/include/gio-unix-2.0/**/*.h",
    ]),
    includes = [
        "usr/include/gio-unix-2.0",
        "usr/include/glib-2.0",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include",
    ],
    deps = [
        ":system_glib",
        ":system_gobject",
    ],
)

cc_library(
    name = "system_gmodule",
    srcs = glob(["usr/lib/" + _TRIPLE + "/libgmodule-2.0.so*"]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/" + _TRIPLE + "/glib-2.0/include",
    ],
    deps = [":system_glib"],
)
